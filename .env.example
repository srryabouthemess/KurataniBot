# ── Discord ───────────────────────────────────────────────────────────────────
# Token do bot → Discord Developer Portal > seu app > Bot > Reset Token
DISCORD_TOKEN=

# ID do seu bot (aparece em General Information)
CLIENT_ID=

# ID do servidor para registrar comandos (deixe vazio para todos os servidores)
GUILD_ID=

# ── Modo do servidor osu! ─────────────────────────────────────────────────────
# "official" → osu! oficial (API v2 com OAuth)
# "private"  → servidor bancho.py (API v1)
OSU_MODE=official

# ── osu! Oficial (API v2) ─────────────────────────────────────────────────────
# Crie em → https://osu.ppy.sh/home/account/edit#new-oauth-application
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# ── Servidor Privado (bancho.py – API v1) ─────────────────────────────────────
# URL base do seu servidor (sem barra no final)
PRIVATE_SERVER_URL=https://seu-servidor.com
# API key definida no config do seu bancho.py
PRIVATE_API_KEY=
