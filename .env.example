# ── Discord ───────────────────────────────────────────────────────────────────
# Token do bot → Discord Developer Portal > seu app > Bot > Reset Token
DISCORD_TOKEN=

# ID do seu bot (aparece em General Information)
CLIENT_ID=

# ── Modo padrão do servidor osu! ──────────────────────────────────────────────
# Usado quando o comando não recebe a opção "server" explicitamente.
# "official"    → osu! oficial (API v2 com OAuth)
# "private"     → Daycore vanilla
# "private_rx"  → Daycore Relax
OSU_MODE=official

# ── osu! Oficial (API v2) ─────────────────────────────────────────────────────
# Crie em → https://osu.ppy.sh/home/account/edit#new-oauth-application
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# ── Cache de mapas (opcional) ─────────────────────────────────────────────────
# Quantos arquivos .osu manter em cache no bot.db. Ao passar do teto, os menos
# usados recentemente são descartados. Cada mapa tem ~50KB (os maiores passam
# de 300KB), então 1500 ≈ 75–150MB. Deixe vazio para usar o padrão.
BEATMAP_CACHE_MAX=

# ── Administração do Daycore (opcional) ───────────────────────────────────────
# Habilita /nominate e /moderate, que mudam o Daycore de verdade.
# Deixe TUDO vazio se este bot não é o do Daycore — os comandos ficam
# desativados (falham fechado) e o resto do bot funciona normalmente.
#
# ID do servidor Discord do Daycore. Os comandos administrativos só funcionam
# lá; em qualquer outro servidor são recusados. Sem isso, ficam desativados.
DAYCORE_GUILD_ID=

# Quantas nomeações distintas um mapa precisa antes de ser aplicado.
# Padrão: 2 (mesmo do osu! oficial).
NOMINATION_THRESHOLD=

# Redis do bancho.py-ex — é por onde as escritas são aplicadas (o bancho
# escuta os canais `rank`, `restrict` e `unrestrict`).
#
# ATENÇÃO: no docker-compose do onl-docker o serviço `redis` não expõe porta
# nenhuma, então o bot não alcança ele por padrão. Rodando o bot no host da
# mesma VPS, adicione ao serviço `redis` do compose:
#
#     ports:
#       - "127.0.0.1:6379:6379"
#
# Isso deixa o Redis acessível só pelo próprio host, não pela internet.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASS=
REDIS_DB=0

# ── Python (necessário só para PP no Daycore RX) ──────────────────────────────
# Binário do Python usado pelo pp_calc.py. Deixe vazio para usar o padrão:
# "python" no Windows, "python3" em Linux/macOS. Só defina se o seu binário
# tiver outro nome/caminho.
PYTHON_BIN=
