# ── Discord ───────────────────────────────────────────────────────────────────
# Token do bot → Discord Developer Portal > seu app > Bot > Reset Token
DISCORD_TOKEN=

# ID do seu bot (aparece em General Information)
CLIENT_ID=

# ── Comandos por texto (opcional) ─────────────────────────────────────────────
# Prefixo dos comandos escritos: com "k!" aqui, `k!rs mrekk` faz o mesmo que
# `/rs player:mrekk`. Vazio = só slash commands.
#
# ATENÇÃO: ler o texto das mensagens exige o MESSAGE CONTENT INTENT, que é
# privilegiado. Habilite antes em Developer Portal > seu app > Bot >
# Privileged Gateway Intents — senão o Discord recusa a conexão e o bot não
# sobe. (Acima de 100 servidores o intent também precisa ser aprovado.)
COMMAND_PREFIX=

# ── Servidores privados (opcional) ────────────────────────────────────────────
# Lista de servidores bancho.py que o bot atende, separados por vírgula. A
# chave vira o valor da opção "server" nos comandos (e a flag `-chave` no modo
# texto). O osu! oficial já vem incluído, com a chave "official".
#
#   SERVERS=daycore,outroservidor
#
# Para cada um, só a URL do site é obrigatória:
#
#   SERVER_DAYCORE_URL=https://daycore.org
#   SERVER_DAYCORE_RELAX=true      # cria também a variante RX (mesma conta)
#   SERVER_DAYCORE_LABEL=Daycore   # nome exibido; padrão: a chave capitalizada
#   SERVER_DAYCORE_API=            # padrão: api.<domínio>
#   SERVER_DAYCORE_AVATARS=        # padrão: a.<domínio>
#   SERVER_DAYCORE_WEB=            # padrão: <site>/api/v1; "none" se não houver
#
# Dois espelhos opcionais, para mapa que só existe naquele servidor — a API
# oficial responde 404 nesse id, e sem eles o embed perde a capa e a linha de
# CS/AR/OD/BPM:
#
#   SERVER_DAYCORE_COVERS=https://osu.daycore.org/mirror-cover   # capa do set
#   SERVER_DAYCORE_MAPFILES=https://osu.daycore.org/mirror-osu   # arquivo .osu
#
# Não há api key: nenhum endpoint que o bot usa pede autenticação.
#
# Os padrões de API e avatar seguem a convenção do onl-docker (bancho.py-ex +
# Shiina-Web). O rank global e as top plays vêm da Shiina-Web (get_rank_cache,
# get_player_scores), que é o FRONT-END e não o bancho.py — se o seu servidor
# roda outro front-end, ponha SERVER_<chave>_WEB=none e o bot busca as duas
# coisas no próprio bancho.py. Sem isso elas vão para um endereço que responde
# a página HTML, e o perfil sai sem rank e sem plays.
SERVERS=

# ── Servidores que já vêm prontos ─────────────────────────────────────────────
# Akatsuki e EZPP Farm não precisam de configuração — API pública e estável.
#
# DEIXE ESTA LINHA COMENTADA para ficar com os dois: ausente = todos, mas
# VAZIA = NENHUM. Descomente só para escolher, listando os que quer manter —
# é o caso de quem hospeda o bot para um servidor só.
#
#   BUILTIN_SERVERS=akatsuki,ezpp

# ── Servidor padrão ───────────────────────────────────────────────────────────
# Usado quando o comando não recebe a opção "server". Aceita "official" ou a
# chave de um servidor do SERVERS (com "_rx" para a variante Relax).
OSU_MODE=official

# ── osu! Oficial (API v2) ─────────────────────────────────────────────────────
# Crie em → https://osu.ppy.sh/home/account/edit#new-oauth-application
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# ── Cache de mapas (opcional) ─────────────────────────────────────────────────
# Quantos arquivos .osu manter em cache no cache.db (arquivo separado do
# bot.db, e descartável a qualquer momento). Ao passar do teto, os menos usados
# recentemente são descartados. Cada mapa tem ~50KB (os maiores passam de
# 300KB), então 1500 ≈ 75–150MB. Deixe vazio para usar o padrão.
BEATMAP_CACHE_MAX=

# Quantos valores de "PP se tivesse sido FC" manter em cache. Esta tabela cresce
# por SCORE e não por mapa (a chave inclui a distribuição de acertos), então tem
# teto próprio; ao passar dele, as entradas mais antigas são descartadas. Cada
# linha são algumas dezenas de bytes, então 20000 ≈ 1–2MB. Vazio = padrão.
FC_PP_CACHE_MAX=

# ── Onde os dados ficam (opcional) ────────────────────────────────────────────
# Diretório de bot.db e cache.db. Vazio = a raiz do projeto, que é onde eles
# sempre estiveram. Serve para manter o banco num volume separado do código,
# já que o deploy na VPS é `git pull` por cima do diretório do projeto.
KURATANI_DATA_DIR=

# ── Comportamento em falha grave (opcional) ───────────────────────────────────
# Depois de uma exceção não capturada, o estado do processo é indefinido: seguir
# rodando pode significar operar sobre estado inconsistente. O padrão é logar e
# continuar, porque sair sem ninguém para reiniciar deixaria o bot fora do ar.
#
# Se você roda com supervisor (systemd, pm2, Docker com restart), preencha com
# `true`: o bot sai com código 1 e volta limpo em vez de seguir quebrado.
EXIT_ON_UNCAUGHT=

# ── Administração do Daycore (opcional) ───────────────────────────────────────
# Habilita /nominate e /moderate, que mudam o Daycore de verdade.
# Deixe TUDO vazio se este bot não é o do Daycore — os comandos ficam
# desativados (falham fechado) e o resto do bot funciona normalmente.
#
# ID do servidor Discord do Daycore. Os comandos administrativos só funcionam
# lá; em qualquer outro servidor são recusados. Sem isso, ficam desativados.
DAYCORE_GUILD_ID=

# Quantas nomeações distintas um mapa precisa antes de ser aplicado.
# Padrão: 1 — quem nomeia já aplica. Suba para 2 se quiser o modelo do osu!
# oficial (dois BNs), ou mais.
NOMINATION_THRESHOLD=

# Canal onde anunciar mapa que mudou de status. O bancho.py-ex não avisa o
# Discord sozinho — quem acompanha só veria pelo site.
#
# Vazio desliga o anúncio: o comando continua funcionando e respondendo a quem
# rodou, só não publica em lugar nenhum. Confira o ID antes de preencher — o
# alvo é um canal público, e o erro aqui não é deixar de anunciar, é anunciar
# no lugar errado. O bot precisa de permissão de enviar mensagem lá.
DAYCORE_ANNOUNCE_CHANNEL_ID=

# Redis do bancho.py-ex — é por onde as escritas são aplicadas (o bancho
# escuta os canais `rank`, `restrict` e `unrestrict`).
#
# ATENÇÃO: no docker-compose do onl-docker o serviço `redis` não expõe porta
# nenhuma, então o bot não alcança ele por padrão. Rodando o bot no host da
# mesma VPS, adicione ao serviço `redis` do compose:
#
#     ports:
#       - "127.0.0.1:6379:6379"
#
# Isso deixa o Redis acessível só pelo próprio host, não pela internet.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASS=
REDIS_DB=0

# ── Python (necessário só para PP no Daycore RX) ──────────────────────────────
# Binário do Python usado pelo pp_calc.py. Deixe vazio para usar o padrão:
# "python" no Windows, "python3" em Linux/macOS. Só defina se o seu binário
# tiver outro nome/caminho.
PYTHON_BIN=
